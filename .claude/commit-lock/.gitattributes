# Hook scripts MUST keep LF line endings. A CRLF shebang (#!/bin/sh\r) is
# rejected by Git-for-Windows' shell with "bad interpreter", which would break
# the installed hooks on any Windows clone. Force LF on checkout everywhere.
hooks/pre-commit  text eol=lf
hooks/post-commit text eol=lf
*.mjs             text eol=lf
